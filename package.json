{
  "name": "j4technologyisnow",
  "version": "1.0.0",
  "description": "Monorepo de J4TechnologyIsNow - Plataforma de Transformación Digital",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter backend start",
    "install:all": "pnpm install -r"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma"]
  }
}
